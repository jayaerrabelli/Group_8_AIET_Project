# Copy to .env and fill in. Both providers have free tiers.
GOOGLE_API_KEY=
GROQ_API_KEY=

# --- Optional overrides (defaults are the models used in the notebooks) -------
# ROUTER_PROVIDER=gemini
# ROUTER_MODEL=gemini-3.5-flash-lite
# BIOMEDICAL_MODEL=qwen/qwen3.8-27b
# FINANCE_MODEL=gemini-3.5-flash-lite
# CUSTOMER_SUPPORT_MODEL=gemini-3.5-flash-lite
# GENERAL_KNOWLEDGE_MODEL=gemini-3.8-flash
#
# Run a domain fully locally with Ollama instead:
# FINANCE_PROVIDER=ollama
# FINANCE_MODEL=llama3.2:3b
#
# How many training records to ingest per source dataset (0 = all)
# GENERAL_KNOWLEDGE_MAX_RECORDS=500
